# ==========================================================
# FINDIT ENVIRONMENT CONFIGURATION GUIDE
# Copy these values into your deployment platform dashboard
# (Render / Railway / Vercel / Netlify / Heroku)
# ==========================================================

# Backend Port (assigned automatically by cloud platforms like Render/Railway/Heroku)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/findit?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/findit?retryWrites=true&w=majority

# JWT Authentication Secret (Use a long random cryptographic string)
JWT_SECRET=super_secure_random_jwt_secret_key_change_me_in_production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s) for CORS
# In unified deployment: leave blank or set to *
# In separated deployment (e.g. Frontend on Vercel): set to https://your-frontend.vercel.app
CLIENT_ORIGIN=*

# Administrative / Moderator Key (required to register moderator accounts via API)
MODERATOR_SECRET_KEY=admin_moderator_secret_passcode_2026

# Client Environment Variable (Only needed if Frontend is hosted on a separate domain like Vercel/Netlify)
# VITE_API_URL=https://your-backend.onrender.com/api

